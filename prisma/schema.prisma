// ============================================================================
// WEBSTUDIO — schema Prisma
// Estrutura de schemas do PostgreSQL espelha exatamente os módulos da
// arquitetura documentada (INTELLIGENCE & DEVELOPMENT INFRASTRUCTURE v3):
//   shared / commercial / delivery / development / integration / reporting
// "integration" (singular) continua sendo as views somente-leitura para o
// Evolure Intelligence, criadas via prisma/views.sql — não confundir com
// "integrations" (plural, módulo de conectores GitHub/CI-CD em app/api).
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["shared", "commercial", "delivery", "development", "integration", "reporting"]
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  CLIENT

  @@schema("shared")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR

  @@schema("shared")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED

  @@schema("shared")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST

  @@schema("commercial")
}

enum OpportunityStage {
  QUALIFYING
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  WON
  LOST

  @@schema("commercial")
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@schema("commercial")
}

enum ContractStatus {
  DRAFT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("commercial")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED

  @@schema("commercial")
}

enum PaymentMethod {
  BANK_TRANSFER
  MPESA
  EMOLA
  CARD
  CASH
  OTHER

  @@schema("commercial")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("commercial")
}

enum ExpenseCategory {
  SOFTWARE
  HOSTING
  MARKETING
  EQUIPMENT
  CONTRACTOR
  TAXES
  OTHER

  @@schema("commercial")
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED

  @@schema("commercial")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED

  @@schema("delivery")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE

  @@schema("delivery")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@schema("delivery")
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  MISSED

  @@schema("delivery")
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("delivery")
}

enum SubtaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@schema("delivery")
}

enum BlockerStatus {
  OPEN
  RESOLVED

  @@schema("delivery")
}

enum ObjectiveStatus {
  ACTIVE
  ACHIEVED
  ABANDONED

  @@schema("development")
}

enum PlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED

  @@schema("development")
}

enum DevelopmentEventType {
  COMMIT
  BRANCH_CREATED
  BRANCH_SWITCHED
  PR_CREATED
  PR_MERGED
  DEPLOYMENT
  BUILD_STARTED
  BUILD_FAILED
  BUILD_SUCCEEDED
  TASK_STARTED
  TASK_COMPLETED
  BLOCKER_RAISED
  BLOCKER_RESOLVED
  INTERRUPTION
  DECISION_LOGGED
  FOCUS_ACTIVITY
  MANUAL_ACTIVITY

  @@schema("development")
}

enum DevelopmentEventSource {
  GIT
  GITHUB
  IDE
  TERMINAL
  WEBSTUDIO_PLANNER
  CI_CD
  DEPLOYMENT
  MANUAL

  @@schema("development")
}

enum InterruptionSource {
  NOTIFICATION
  MEETING
  CONTEXT_SWITCH
  MANUAL
  UNKNOWN

  @@schema("development")
}

// ---------------------------------------------------------------------------
// SHARED — users, clients, permissões, auditoria
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(STAFF)
  image        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadsOwned         Lead[]         @relation("LeadOwner")
  opportunitiesOwned Opportunity[]  @relation("OpportunityOwner")
  proposalsCreated   Proposal[]     @relation("ProposalCreator")
  projectsOwned      Project[]      @relation("ProjectOwner")
  tasksAssigned      Task[]         @relation("TaskAssignee")
  expensesCreated    Expense[]      @relation("ExpenseCreator")
  filesUploaded      FileAsset[]    @relation("FileUploader")
  notifications      Notification[]
  apiKeys            ApiKey[]
  activities         Activity[]     @relation("ActivityUser")
  auditLogs          AuditLog[]     @relation("AuditActor")
  blockersRaised     Blocker[]      @relation("BlockerRaisedBy")
  timeEntries        TimeEntry[]    @relation("TimeEntryUser")

  developmentEvents    DevelopmentEvent[]
  developmentLogs      DevelopmentLog[]
  focusSessions        FocusSession[]
  developmentDecisions DevelopmentDecision[]
  objectivesOwned      Objective[]           @relation("ObjectiveOwner")

  @@map("users")
  @@schema("shared")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String
  scopes     String[]  @default([])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("api_keys")
  @@schema("shared")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
  @@schema("shared")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  taxId     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads      Lead[]
  proposals  Proposal[]
  contracts  Contract[]
  projects   Project[]
  invoices   Invoice[]
  activities Activity[] @relation("ActivityClient")

  @@map("clients")
  @@schema("shared")
}

model Activity {
  id          String   @id @default(cuid())
  type        String // lead.created, proposal.sent, invoice.paid...
  description String
  entityType  String
  entityId    String
  userId      String?
  user        User?    @relation("ActivityUser", fields: [userId], references: [id])
  clientId    String?
  client      Client?  @relation("ActivityClient", fields: [clientId], references: [id])
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("activities")
  @@schema("shared")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(INFO)
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
  @@schema("shared")
}

model Outbox {
  id          String       @id @default(cuid())
  eventType   String // client.created, lead.created, invoice.paid, development_event.created...
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status])
  @@map("outbox")
  @@schema("shared")
}

// ---------------------------------------------------------------------------
// COMMERCIAL — leads, propostas, contratos, faturação, marketing
// ---------------------------------------------------------------------------

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  source    String?
  message   String?
  status    LeadStatus @default(NEW)
  ownerId   String?
  owner     User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  clientId  String?
  client    Client?    @relation(fields: [clientId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  proposals     Proposal[]
  opportunities Opportunity[]

  @@map("leads")
  @@schema("commercial")
}

/// Oportunidade qualificada nascida de um Lead — acompanha estágio e valor
/// estimado até virar Proposal/Contract (ou ser perdida).
model Opportunity {
  id                String           @id @default(cuid())
  leadId            String?
  lead              Lead?            @relation(fields: [leadId], references: [id])
  title             String
  estimatedValue    Decimal?         @db.Decimal(14, 2)
  probability       Int              @default(50) // 0-100
  stage             OpportunityStage @default(QUALIFYING)
  expectedCloseDate DateTime?
  ownerId           String?
  owner             User?            @relation("OpportunityOwner", fields: [ownerId], references: [id])
  closedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("opportunities")
  @@schema("commercial")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(14, 2)
  unit        String   @default("projeto")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
  @@schema("commercial")
}

model Proposal {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id])
  title       String
  description String?
  items       Json
  totalAmount Decimal        @db.Decimal(14, 2)
  status      ProposalStatus @default(DRAFT)
  validUntil  DateTime?
  sentAt      DateTime?
  respondedAt DateTime?
  createdById String?
  createdBy   User?          @relation("ProposalCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  contract Contract?

  @@map("proposals")
  @@schema("commercial")
}

model Contract {
  id         String         @id @default(cuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  proposalId String?        @unique
  proposal   Proposal?      @relation(fields: [proposalId], references: [id])
  title      String
  terms      String?
  value      Decimal        @db.Decimal(14, 2)
  startDate  DateTime?
  endDate    DateTime?
  status     ContractStatus @default(DRAFT)
  signedAt   DateTime?
  fileUrl    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  projects Project[]

  @@map("contracts")
  @@schema("commercial")
}

model Invoice {
  id        String        @id @default(cuid())
  number    String        @unique
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id])
  items     Json
  subtotal  Decimal       @db.Decimal(14, 2)
  tax       Decimal       @default(0) @db.Decimal(14, 2)
  total     Decimal       @db.Decimal(14, 2)
  status    InvoiceStatus @default(DRAFT)
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  payments Payment[]

  @@map("invoices")
  @@schema("commercial")
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  reference String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@map("payments")
  @@schema("commercial")
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime        @default(now())
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  createdById String?
  createdBy   User?           @relation("ExpenseCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@map("expenses")
  @@schema("commercial")
}

model Campaign {
  id        String         @id @default(cuid())
  name      String
  channel   String
  budget    Decimal?       @db.Decimal(14, 2)
  status    CampaignStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  metrics   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("campaigns")
  @@schema("commercial")
}

// ---------------------------------------------------------------------------
// DELIVERY — projetos, tarefas, arquivos de entrega
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  contractId  String?
  contract    Contract?     @relation(fields: [contractId], references: [id])
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  budget      Decimal?      @db.Decimal(14, 2)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  ownerId     String?
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks             Task[]
  invoices          Invoice[]
  expenses          Expense[]
  developmentEvents DevelopmentEvent[]
  developmentLogs   DevelopmentLog[]
  focusSessions     FocusSession[]
  roadmaps          Roadmap[]
  milestones        Milestone[]
  sprints           Sprint[]

  @@map("projects")
  @@schema("delivery")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id])
  sprintId    String?
  sprint      Sprint?      @relation(fields: [sprintId], references: [id])
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  developmentEvents    DevelopmentEvent[]
  developmentLogs      DevelopmentLog[]
  focusSessions        FocusSession[]
  developmentDecisions DevelopmentDecision[]
  subtasks             Subtask[]
  blockers             Blocker[]
  timeEntries          TimeEntry[]

  @@map("tasks")
  @@schema("delivery")
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  title       String
  description String?
  status      MilestoneStatus @default(PLANNED)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tasks Task[]

  @@map("milestones")
  @@schema("delivery")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tasks Task[]

  @@map("sprints")
  @@schema("delivery")
}

model Subtask {
  id          String        @id @default(cuid())
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id])
  title       String
  status      SubtaskStatus @default(TODO)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("subtasks")
  @@schema("delivery")
}

model Blocker {
  id          String        @id @default(cuid())
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id])
  description String
  status      BlockerStatus @default(OPEN)
  raisedById  String?
  raisedBy    User?         @relation("BlockerRaisedBy", fields: [raisedById], references: [id])
  raisedAt    DateTime      @default(now())
  resolvedAt  DateTime?
  resolution  String?

  @@map("blockers")
  @@schema("delivery")
}

/// Horas efetivamente trabalhadas, lançadas manualmente ou por timer —
/// independente do DevelopmentLog (evidência de atividade via Git/IDE/etc.),
/// conforme o princípio "Git != TimeEntry" da arquitetura v3.
model TimeEntry {
  id           String    @id @default(cuid())
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id])
  userId       String?
  user         User?     @relation("TimeEntryUser", fields: [userId], references: [id])
  startedAt    DateTime
  endedAt      DateTime?
  durationMins Int?
  note         String?
  createdAt    DateTime  @default(now())

  @@map("time_entries")
  @@schema("delivery")
}

model FileAsset {
  id           String   @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  entityType   String
  entityId     String
  uploadedById String?
  uploadedBy   User?    @relation("FileUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@map("project_files")
  @@schema("delivery")
}

// ---------------------------------------------------------------------------
// DELIVERY / DEVELOPMENT — Development Lab (planeamento, execução, atividade)
// ---------------------------------------------------------------------------

model Objective {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      ObjectiveStatus @default(ACTIVE)
  targetDate  DateTime?
  ownerId     String?
  owner       User?           @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roadmaps Roadmap[]

  @@map("objectives")
  @@schema("development")
}

model Roadmap {
  id          String     @id @default(cuid())
  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id])
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  weeklyPlans WeeklyPlan[]

  @@map("roadmaps")
  @@schema("development")
}

model WeeklyPlan {
  id         String     @id @default(cuid())
  roadmapId  String?
  roadmap    Roadmap?   @relation(fields: [roadmapId], references: [id])
  weekStart  DateTime
  weekEnd    DateTime
  goals      Json // lista de metas da semana
  status     PlanStatus @default(PLANNED)
  reviewNote String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  dailyPlans DailyPlan[]

  @@map("weekly_plans")
  @@schema("development")
}

model DailyPlan {
  id           String      @id @default(cuid())
  weeklyPlanId String?
  weeklyPlan   WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id])
  date         DateTime
  priorities   Json // lista ordenada de prioridades do dia
  status       PlanStatus  @default(PLANNED)
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("daily_plans")
  @@schema("development")
}

/// Camada intermediária de eventos: Git, IDE, Terminal, Planner e CI/CD
/// nunca escrevem diretamente em DevelopmentLog ou FocusSession — todos
/// emitem um DevelopmentEvent, que é distribuído para os processors.
model DevelopmentEvent {
  id         String                 @id @default(cuid())
  source     DevelopmentEventSource
  eventType  DevelopmentEventType
  userId     String?
  user       User?                  @relation(fields: [userId], references: [id])
  projectId  String?
  project    Project?               @relation(fields: [projectId], references: [id])
  taskId     String?
  task       Task?                  @relation(fields: [taskId], references: [id])
  externalId String? // ex: SHA do commit, ID do PR
  metadata   Json?
  timestamp  DateTime               @default(now())
  createdAt  DateTime               @default(now())

  developmentLogs DevelopmentLog[]

  @@index([source, eventType])
  @@index([projectId])
  @@map("development_events")
  @@schema("development")
}

/// Evidência de atividade — NÃO representa horas trabalhadas (isso é
/// responsabilidade do TimeEntry, que continua independente).
model DevelopmentLog {
  id            String            @id @default(cuid())
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id])
  taskId        String?
  task          Task?             @relation(fields: [taskId], references: [id])
  sourceEventId String?
  sourceEvent   DevelopmentEvent? @relation(fields: [sourceEventId], references: [id])
  activityType  String
  description   String
  confidence    Float             @default(1.0)
  timestamp     DateTime          @default(now())
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([projectId])
  @@map("development_logs")
  @@schema("development")
}

/// Inferida a partir de múltiplos sinais (Git + IDE + Terminal + Planner),
/// não depende exclusivamente de commits.
model FocusSession {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id])
  startedAt     DateTime
  endedAt       DateTime?
  durationSecs  Int?
  activityScore Float?
  confidence    Float     @default(1.0)
  sourceEvents  String[]  @default([]) // ids de DevelopmentEvent
  inferred      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  interruptions Interruption[]

  @@index([projectId])
  @@map("focus_sessions")
  @@schema("development")
}

model Interruption {
  id             String             @id @default(cuid())
  focusSessionId String?
  focusSession   FocusSession?      @relation(fields: [focusSessionId], references: [id])
  source         InterruptionSource @default(UNKNOWN)
  reason         String?
  startedAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime           @default(now())

  @@map("interruptions")
  @@schema("development")
}

/// Decisões técnicas capturadas via CLI/shortcut (ex: `/decision ...`),
/// sempre pertencentes ao WebStudio Development Lab.
model DevelopmentDecision {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  relatedTaskId String?
  relatedTask   Task?    @relation(fields: [relatedTaskId], references: [id])
  context       String?
  decision      String
  reason        String?
  alternatives  Json? // lista de alternativas consideradas
  impact        String?
  createdAt     DateTime @default(now())

  @@map("development_decisions")
  @@schema("development")
}

/// Agregação diária/leve de atividade de desenvolvimento por utilizador —
/// alimentada pelos processors a partir de DevelopmentEvent, usada como
/// fonte rápida para o Analytics Engine do Labs sem recalcular do zero.
model DevelopmentActivity {
  id         String   @id @default(cuid())
  userId     String?
  date       DateTime
  eventCount Int      @default(0)
  focusSecs  Int      @default(0)
  summary    Json?
  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@map("development_activity")
  @@schema("development")
}
